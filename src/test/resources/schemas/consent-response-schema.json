{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Consent Response Schema",
  "description": "JSON schema for Account Aggregator Consent API response validation",
  "type": "object",
  "required": [
    "ver",
    "timestamp",
    "txnid",
    "Customer",
    "ConsentHandle",
    "ConsentStatus"
  ],
  "properties": {
    "ver": {
      "type": "string",
      "pattern": "^1\\.0$",
      "description": "API version"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "txnid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "Unique transaction identifier"
    },
    "Customer": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Customer identifier"
        }
      },
      "additionalProperties": false
    },
    "ConsentHandle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Unique consent handle"
    },
    "ConsentStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "READY",
        "ACTIVE",
        "PAUSED",
        "EXPIRED",
        "DENIED",
        "REVOKED"
      ],
      "description": "Current status of the consent"
    }
  },
  "additionalProperties": false
}